[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libjoyfiles_core.so"
linux.release.x86_64 = "res://bin/libjoyfiles_core.so"
windows.debug.x86_64 = "res://bin/joyfiles_core.dll"
windows.release.x86_64 = "res://bin/joyfiles_core.dll"
